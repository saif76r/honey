rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Users collection: user profiles
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if false;
      allow create, update: if isValidId(userId)
        && incoming().id is string
        && incoming().name is string && incoming().name.size() <= 60
        && incoming().email is string
        && incoming().partnerCode is string;
      allow delete: if false;
    }

    // Pairings collection: lookup partner by code
    match /pairings/{partnerCode} {
      allow get: if isValidId(partnerCode);
      allow list: if false;
      allow create, update: if isValidId(partnerCode)
        && incoming().code is string
        && incoming().userId is string
        && incoming().userName is string;
      allow delete: if false;
    }

    // Messages collection: encrypted romantic messages
    match /messages/{messageId} {
      allow get: if isValidId(messageId);
      allow list: if true;
      allow create: if isValidId(messageId)
        && incoming().id is string
        && incoming().senderId is string
        && incoming().receiverId is string
        && incoming().type in ['text', 'image', 'voice', 'sealed_letter', 'sticker'];
      allow update: if isValidId(messageId)
        && incoming().senderId == existing().senderId
        && incoming().receiverId == existing().receiverId;
      allow delete: if isValidId(messageId);
    }

    // Typing status collection
    match /typing/{typingId} {
      allow read, write: if isValidId(typingId);
    }

    // Connection testing doc
    match /test/connection {
      allow read: if true;
    }
  }
}
