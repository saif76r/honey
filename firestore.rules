rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users collection: user profiles & cross-device sync
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if false;
      allow create, update: if isValidId(userId);
      allow delete: if false;
    }

    // Pairings collection: lookup partner by code
    match /pairings/{partnerCode} {
      allow get: if isValidId(partnerCode);
      allow list: if false;
      allow create, update: if isValidId(partnerCode);
      allow delete: if false;
    }

    // Messages collection: encrypted romantic messages & reactions
    match /messages/{messageId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(messageId);
    }

    // Typing status collection
    match /typing/{typingId} {
      allow read, write: if isValidId(typingId);
    }

    // Connection testing doc
    match /test/connection {
      allow read: if true;
    }
  }
}

